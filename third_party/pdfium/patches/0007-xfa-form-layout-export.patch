+bool HasFormField(CXFA_Node* node) {
+  if (node->GetElementType() == XFA_Element::Field ||
+      node->GetElementType() == XFA_Element::ExclGroup) {
+    return true;
+  }
+  for (CXFA_Node* child = node->GetFirstChild(); child;
+       child = child->GetNextSibling()) {
+    if (HasFormField(child)) {
+      return true;
+    }
+  }
+  return false;
+}
