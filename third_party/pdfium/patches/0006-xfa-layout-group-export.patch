+namespace {
+
+void CollectLayoutOnlyGroups(CXFA_Node* node,
+                             std::set<CFX_XMLNode*>* excluded) {
+  if (node->GetElementType() == XFA_Element::DataGroup &&
+      !node->GetFirstChild()) {
+    const auto bindings = node->GetBindItemsCopy();
+    if (!bindings.empty() &&
+        std::all_of(bindings.begin(), bindings.end(), [](CXFA_Node* binding) {
+          return binding->IsLayoutGeneratedNode();
+        })) {
+      excluded->insert(node->GetXMLMappingNode());
+    }
+  }
+  for (CXFA_Node* child = node->GetFirstChild(); child;
+       child = child->GetNextSibling()) {
+    CollectLayoutOnlyGroups(child, excluded);
+  }
+}
+
+CFX_XMLNode* CloneFiltered(CFX_XMLNode* original,
+                           CFX_XMLDocument* document,
+                           const std::set<CFX_XMLNode*>& excluded) {
+  CFX_XMLNode* copy = original->Clone(document);
+  // Element Clone copies text children only; rebuild the complete subtree.
+  while (CFX_XMLNode* child = copy->GetFirstChild()) {
+    copy->RemoveChild(child);
+  }
+  for (CFX_XMLNode* child = original->GetFirstChild(); child;
+       child = child->GetNextSibling()) {
+    if (!excluded.contains(child)) {
+      copy->AppendLastChild(CloneFiltered(child, document, excluded));
+    }
+  }
+  return copy;
+}
+
+}  // namespace
 
