# Copy to .env, then replace with a published Docker Hub tag or immutable digest.
PDF_EDITOR_IMAGE=ewave267/pdf-editor:0.1.0
# Match your host user IDs (id -u / id -g); host home is detected automatically.
PDF_EDITOR_UID=1000
PDF_EDITOR_GID=1000
# Optional extra folder; the host root is already accessible under ~/host_fs.
PDF_EDITOR_DOCUMENTS=./documents
PDF_EDITOR_PORT=8080
