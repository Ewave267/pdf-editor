<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
  <config xmlns="http://www.xfa.org/schema/xci/3.0/">
    <present>
      <pdf><version>1.7</version><renderPolicy>client</renderPolicy><interactive>1</interactive></pdf>
      <script><runScripts>client</runScripts></script>
    </present>
    <acrobat><acrobat7><dynamicRender>required</dynamicRender></acrobat7></acrobat>
  </config>
  <template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
    <subform name="form1" layout="tb" locale="en_US" restoreState="auto">
      <pageSet>
        <pageArea name="page1">
          <contentArea x="0pt" y="0pt" w="612pt" h="792pt"/>
          <medium stock="default" short="612pt" long="792pt"/>
        </pageArea>
      </pageSet>
      <subform name="body" w="612pt" h="792pt" layout="position">
        <field name="input" x="72pt" y="72pt" w="200pt" h="30pt">
          <ui><textEdit/></ui>
          <font typeface="Helvetica" size="12pt"/>
          <value><text>original</text></value>
          <event activity="initialize">
            <script contentType="application/x-javascript" runAt="client">xfa.host.gotoURL("https://example.invalid/blocked");</script>
          </event>
          <event activity="exit">
            <script contentType="application/x-javascript" runAt="client">calculated.rawValue = "JS:" + this.rawValue;</script>
          </event>
          <border><edge/></border>
        </field>
        <field name="calculated" x="72pt" y="132pt" w="240pt" h="30pt">
          <ui><textEdit/></ui>
          <font typeface="Helvetica" size="12pt"/>
          <calculate>
            <script contentType="application/x-javascript" runAt="client">this.rawValue = "JS:" + input.rawValue;</script>
          </calculate>
          <border><edge/></border>
        </field>
      </subform>
    </subform>
  </template>
  <xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/">
    <xfa:data><form1><body><input>original</input></body></form1></xfa:data>
  </xfa:datasets>
</xdp:xdp>
