<!-- Original synthetic two-page navigation fixture. -->
<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/">
  <config xmlns="http://www.xfa.org/schema/xci/3.0/">
    <present><pdf><version>1.7</version><renderPolicy>client</renderPolicy><interactive>1</interactive></pdf></present>
    <acrobat><acrobat7><dynamicRender>required</dynamicRender></acrobat7></acrobat>
  </config>
  <template xmlns="http://www.xfa.org/schema/xfa-template/3.3/">
    <subform name="form1" layout="tb" locale="en_US">
      <pageSet><pageArea name="page1"><contentArea x="0pt" y="0pt" w="612pt" h="792pt"/><medium stock="default" short="612pt" long="792pt"/></pageArea></pageSet>
      <subform name="firstPage" w="612pt" h="792pt" layout="position">
        <field name="first" x="72pt" y="72pt" w="240pt" h="30pt"><ui><textEdit/></ui><font typeface="Helvetica" size="12pt"/><value><text>first</text></value><border><edge/></border></field>
      </subform>
      <subform name="secondPage" w="612pt" h="792pt" layout="position">
        <breakBefore targetType="pageArea" startNew="1"/>
        <field name="second" x="72pt" y="600pt" w="240pt" h="30pt"><ui><textEdit/></ui><font typeface="Helvetica" size="12pt"/><value><text>second</text></value><border><edge/></border></field>
      </subform>
    </subform>
  </template>
  <xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><xfa:data/></xfa:datasets>
</xdp:xdp>
